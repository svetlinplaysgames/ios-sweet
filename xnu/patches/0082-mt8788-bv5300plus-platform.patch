 #define SWEET                     1
 
-/* All eight cores (six A55 + two A76) as one homogeneous SMP cluster */
+/*
+ * Blackview BV5300 Plus (MT8788V / MT6771):
+ * 8 cores: 4x Cortex-A53 (Cluster 0) + 4x Cortex-A73 (Cluster 1).
+ * Supports both Qualcomm (Aff1=Core) and MediaTek (Aff1=Cluster, Aff0=Core)
+ * topology configurations.
+ */
 #define SWEET_SMP_MAX_CPUS         8
+#define MT8788_BV5300PLUS         1
 
 #define ARM_ARCH_TIMER
 #define __ARM_ARCH__              8
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -73,9 +73,15 @@
 	if (*(const uint32_t *)reg->getBytesNoCopy() != cpu->phys_id) {
 		return false;
 	}
-	/* MPIDR Aff1 = core: 0x000-0x500 A55, 0x600/0x700 A76 */
-	if (cpu->phys_id > 0x700 || (cpu->phys_id & 0xff) != 0 ||
-	    topology->num_cpus > SWEET_SMP_MAX_CPUS) {
+	/*
+	 * Validate CPU MPIDR:
+	 * Qualcomm SM7150: Aff1=Core (0x000-0x700), Aff0=0
+	 * MediaTek MT8788: Cluster 0 Aff0=0..3, Cluster 1 Aff1=1 Aff0=0..3 (0x100..0x103)
+	 */
+	bool valid_qcom = (cpu->phys_id <= 0x700 && (cpu->phys_id & 0xff) == 0);
+	bool valid_mtk  = ((cpu->phys_id >> 8) <= 1 && (cpu->phys_id & 0xff) <= 3);
+
+	if ((!valid_qcom && !valid_mtk) || topology->num_cpus > SWEET_SMP_MAX_CPUS) {
 		panic("SWEET CPU: invalid topology cpu=%u mpidr=0x%x count=%u",
 		    cpu->cpu_id, cpu->phys_id, topology->num_cpus);
 	}
